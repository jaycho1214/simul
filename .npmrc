# NOTE: verified empirically that pnpm 11.20.0 does not honor node-linker (or
# block-exotic-subdeps) from a project-level .npmrc in this workspace — only a
# `pnpm install --config.node-linker=hoisted` CLI override or the equivalent
# field in pnpm-workspace.yaml actually changes the on-disk layout. The real,
# effective settings live in pnpm-workspace.yaml (nodeLinker, blockExoticSubdeps).
# This file is kept for whichever settings *are* project-npmrc-scoped (registry,
# auth) and so `node-linker=hoisted` is discoverable by anyone grepping .npmrc
# first, per the plan's original instruction.
node-linker=hoisted
