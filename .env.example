# Read by `pnpm serve` (the headless server) only. The operator app has its own
# settings — the API key in 제어, the languages in 언어 — and strips every
# variable below from the environment it inherits, so nothing here reaches it.
GEMINI_API_KEY=
INGEST_TOKEN=
PORT=8080
OFFERED_LANGUAGES=["ko","en","es","ja"]
# Every offered language is translated by the model, which detects what is
# spoken and parrots speech already in the target language; there is no source
# language. true adds an untranslated "original" lane, last in the picker and
# tagged as debug, for checking the capture chain. Off for an event.
PASSTHROUGH_LANE=false
MAX_CONCURRENT_LANES=6
LANE_GRACE_MS=60000
TRANSCRIPT_HISTORY_LINES=200
TRANSCRIPT_DELAY_MS=0
OPUS_BITRATE=128000
# The attendee app plays through MediaSource where the browser supports it
# (~1-1.5 s behind the room at any bitrate). Phones that cannot (iPhone Safari)
# fall back to a plain <audio src>, and for THEM the bitrate is a latency
# setting, not a quality one: Chrome-style players hand the demuxer only whole
# 32 KiB blocks, so the wire byte rate sets their floor. 24 kbps made that
# ~16 s; 128 kbps makes it ~3 s, at ~16 KB/s per such phone (60 phones ~ 8 Mbps
# of wifi). When the server runs inside the operator app, the app's own
# settings file sets this and wins over this line.
# STREAM_PRIME_MS pre-fills that first block from recent audio. It is added to
# a plain-path listener's latency, since playback starts at the oldest cluster
# sent, so keep it just above one block. 0 disables it.
# Leave unset: the default is derived from OPUS_BITRATE to fill 1.5 blocks.
# STREAM_PRIME_MS=
WEB_ROOT=

# Brand — all optional. Unset means an unbranded, dark, steel-blue app.
# BRAND_ACCENT takes #rgb or #rrggbb, with or without the hash; anything the
# operator picks is adjusted at runtime until it is legible on the theme's
# background and can carry readable text.
BRAND_NAME=
BRAND_ACCENT=
BRAND_LOGO=
BRAND_THEME=dark
